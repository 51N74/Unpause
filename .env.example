# Root / Shared Environment Example
# Copy to apps/api-go/.env and apps/web/.env as needed

# Go/Gin Backend (apps/api-go/.env)
NODE_ENV=development
PORT=4000
# Local dev default uses sslmode=disable; in production with Neon use ?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/unpause?sslmode=disable"
SESSION_SECRET="replace-with-a-secure-random-secret-at-least-32-chars"
SESSION_COOKIE_NAME="unpause_sid"
SESSION_COOKIE_SAMESITE="lax"
SESSION_COOKIE_SECURE="false"
SESSION_TTL_HOURS=168
AUTH_RATE_LIMIT_MAX=25
CORS_ORIGINS="http://localhost:5173"
STATIC_FILES_DIR=""
AUTO_MIGRATE="false"
GITHUB_API_BASE_URL="https://api.github.com"
GITHUB_TOKEN=""

# Frontend (apps/web/.env)
VITE_API_BASE_URL="/api/v1"
