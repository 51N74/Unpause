# Git & VCS
.git
.gitignore

# Dependencies & local build artifacts (rebuilt cleanly inside multi-stage Docker build)
node_modules
apps/*/node_modules
dist
build
apps/*/dist
apps/api-go/bin

# Local databases, test coverage, and logs
.pglite
coverage
*.log
*.tsbuildinfo
.DS_Store

# Environment files & secrets (never copy into Docker build context)
.env
.env.*
apps/*/.env
apps/*/.env.*

# Legacy reference Node API source (only apps/api/package.json is needed for npm workspaces lockfile validation)
apps/api/src
apps/api/prisma
apps/api/tests
